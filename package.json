{
  "name": "streamaxt-workspace",
  "version": "1.0.0",
  "engines": { "node": ">=22.5.0" },
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=server"
  },
  "keywords": [
    "streamaxt",
    "twitch",
    "kick",
    "youtube",
    "discord",
    "tiktok",
    "streaming-bot"
  ],
  "author": "Axthrowa",
  "license": "MIT"
}

