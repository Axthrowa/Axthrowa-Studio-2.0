# Windows hedefini Linux konteynerde derler.
#
# Neden: Smart App Control, Windows'ta cargo'nun ürettiği build script
# çalıştırılabilirlerini engelliyor (os error 4551) ve kapatılması geri
# alınamaz bir sistem değişikliği. Konteyner içinde SAC devrede olmadığı için
# aynı kaynak sorunsuz derleniyor; çıktı yine gerçek bir Windows .exe.
FROM rust:1-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
      clang lld llvm cmake nasm pkg-config ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Testleri konteynerde koşabilmek için Linux hedefinin sistem bağımlılıkları.
# Windows çıktısı bunları kullanmıyor; yalnız `cargo test` için gerekli,
# çünkü Windows binary'si Linux'ta çalıştırılamaz.
RUN apt-get update && apt-get install -y --no-install-recommends       libwebkit2gtk-4.1-dev libgtk-3-dev libsoup-3.0-dev       librsvg2-dev libayatana-appindicator3-dev build-essential     && rm -rf /var/lib/apt/lists/*

RUN rustup target add x86_64-pc-windows-msvc
RUN cargo install --locked cargo-xwin

# Windows SDK başlıkları imaja gömülsün ki her çalıştırmada indirilmesin.
ENV XWIN_CACHE_DIR=/opt/xwin
RUN cargo xwin --version

WORKDIR /work
ENV CARGO_TARGET_DIR=/work/target-docker
